{
  "name": "ckb-mixer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --test-scheduled",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "web:deploy": "wrangler deploy --config deploy/wrangler.toml",
    "build:pages": "VITE_AGGREGATOR_URL=/aggregator npm run build",
    "build:web": "VITE_AGGREGATOR_URL=https://ckb-mixer-aggregator.tianlitao3399.workers.dev npm run build && rm -f dist/_worker.js",
    "pages:deploy": "npm run build:pages && wrangler pages deploy dist --project-name ckb-mixer-web",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "@ckb-ccc/ccc": "^1.3.7",
    "@ckb-ccc/connector": "^2.4.0",
    "@ckb-ccc/core": "^1.23.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
