{
  "name": "ckb-mixer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --test-scheduled",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "pages:deploy": "wrangler pages deploy dist --project-name ckb-mixer-testnet",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "@ckb-ccc/ccc": "^1.3.7",
    "@ckb-ccc/core": "^1.23.1",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
